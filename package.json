{
  "name": "naru",
  "version": "0.0.0",
  "private": true,
  "description": "A WebGPU-native engine for massive CAD and BIM.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "adapter:ifc:test": "node scripts/run-adapter-ifc-tests.mjs",
    "adr:check": "node scripts/validate-adrs.mjs",
    "docs:links:check": "node scripts/validate-markdown-links.mjs",
    "docs:api": "pnpm run workspace:types && pnpm --filter @naru3d/compiler run build && pnpm exec typedoc",
    "docs:api:check": "pnpm exec typedoc --emit none",
    "build": "pnpm --recursive --if-present run build",
    "browser:evidence:check": "node scripts/validate-browser-evidence.mjs",
    "browser:matrix": "node scripts/record-browser-matrix.mjs",
    "demo:smoke": "node scripts/check-public-demo.mjs",
    "cache:check": "node scripts/validate-import-cache-evidence.mjs",
    "cache:sixty5:check": "node scripts/validate-sixty5-cache-evidence.mjs",
    "cache:payload:check": "node scripts/validate-payload-reuse-evidence.mjs",
    "cache:stages:check": "node scripts/validate-rebuild-stage-evidence.mjs",
    "structure:first-emission:check": "node scripts/validate-structure-first-emission-evidence.mjs",
    "structure:first-emission:evidence": "node scripts/record-structure-first-emission-evidence.mjs",
    "staged:import:browser:check": "node scripts/validate-staged-import-browser-evidence.mjs",
    "staged:import:browser:evidence": "node scripts/record-staged-import-browser-evidence.mjs",
    "structure:readiness:check": "node scripts/validate-structure-readiness-evidence.mjs",
    "structure:readiness:evidence": "node scripts/record-structure-readiness-evidence.mjs",
    "fuzz:evidence": "node scripts/record-package-fuzz-evidence.mjs",
    "fuzz:check": "node scripts/validate-package-fuzz-evidence.mjs",
    "embedder:evidence": "pnpm --filter @naru3d/runtime-webgpu build && pnpm --filter @naru3d/package-embedder build && node scripts/record-embedder-override-evidence.mjs",
    "embedder:check": "node scripts/validate-embedder-override-evidence.mjs",
    "cache:sixty5:evidence": "pnpm --filter @naru3d/compiler... run build && node scripts/record-sixty5-cache-evidence.mjs",
    "cache:stages:evidence": "pnpm --filter @naru3d/compiler... run build && node scripts/record-rebuild-stage-evidence.mjs",
    "node-fields:check": "node scripts/validate-node-field-elision-evidence.mjs",
    "hierarchy:relocation:check": "node scripts/validate-hierarchy-relocation-evidence.mjs",
    "lod:method:check": "node scripts/validate-lod-method-comparison-evidence.mjs",
    "lod:method:evidence": "pnpm --filter @naru3d/compiler... --filter @naru3d/runtime-webgpu... run build && node scripts/record-lod-method-comparison-evidence.mjs",
    "lod:reduced:check": "node scripts/validate-reduced-lod-evidence.mjs",
    "lod:reduced:evidence": "pnpm --filter @naru3d/compiler... run build && node scripts/record-reduced-lod-evidence.mjs",
    "lod:selection:check": "node scripts/validate-reduced-lod-browser-evidence.mjs",
    "lod:selection:evidence": "node scripts/record-reduced-lod-browser-evidence.mjs",
    "hierarchy:browser:check": "node scripts/validate-relocated-hierarchy-browser-evidence.mjs",
    "hierarchy:browser:evidence": "node scripts/record-relocated-hierarchy-browser-evidence.mjs",
    "workspace:reopen:check": "node scripts/validate-workspace-reopen-evidence.mjs",
    "workspace:reopen:evidence": "node scripts/record-workspace-reopen-evidence.mjs",
    "demo:browser:check": "node scripts/validate-public-demo-browser-evidence.mjs",
    "demo:browser:evidence": "node scripts/record-public-demo-browser-evidence.mjs",
    "demo:baseline:check": "node scripts/validate-engineering-baseline-origin-evidence.mjs",
    "demo:baseline:evidence": "node scripts/record-public-demo-browser-evidence.mjs --package-origin https://packages.blacktanlabs.com/naru/engineering-baseline/v1/ --build-report artifacts/public-demo/engineering-baseline-origin/build-report.json --open-via scene-query --timeout-ms 600000 --output artifacts/public-demo/engineering-baseline-origin",
    "hierarchy:relocation:evidence": "pnpm --filter @naru3d/compiler... --filter @naru3d/runtime-webgpu... run build && node scripts/record-hierarchy-relocation-evidence.mjs",
    "node-fields:evidence": "pnpm --filter @naru3d/compiler... --filter @naru3d/runtime-webgpu... run build && node scripts/record-node-field-elision-evidence.mjs",
    "cache:evidence": "pnpm --filter @naru3d/compiler... run build && node scripts/record-import-cache-evidence.mjs",
    "check": "pnpm run adr:check && pnpm run fixtures:check && pnpm run fixtures:external:check && pnpm run occt:diagnostics:check && pnpm run phase1:evidence:check && pnpm run ifc:edges:check && pnpm run ifc:federation:check && pnpm run ifc:engineering:check && pnpm run ifc:browser:check && pnpm run ifc:first-frame:check && pnpm run ifc:first-frame:gecko:check && pnpm run browser:evidence:check && pnpm run safari:compatibility:check && pnpm run precision:check && pnpm run spatial:check && pnpm run spatial:localized:check && pnpm run demand:priority:check && pnpm run cache:check && pnpm run cache:sixty5:check && pnpm run cache:payload:check && pnpm run cache:stages:check && pnpm run structure:readiness:check && pnpm run structure:first-emission:check && pnpm run staged:import:browser:check && pnpm run fuzz:check && pnpm run embedder:check && pnpm run node-fields:check && pnpm run hierarchy:relocation:check && pnpm run lod:method:check && pnpm run lod:reduced:check && pnpm run lod:selection:check && pnpm run hierarchy:browser:check && pnpm run workspace:reopen:check && pnpm run demo:browser:check && pnpm run demo:baseline:check && pnpm run memory:envelope:check && pnpm run benchmark:industrial:check && pnpm run benchmark:heterogeneous:check && pnpm run benchmark:repeatability:check && pnpm run benchmark:gpu-timing:check && pnpm run benchmark:gpu-timing:integrated:check && pnpm run docs:links:check && pnpm run lint && pnpm run typecheck && pnpm run docs:api:check && pnpm run test && pnpm run build",
    "dev": "pnpm --filter @naru3d/webgpu-spike run dev",
    "fixtures:check": "node scripts/validate-fixture-manifest.mjs",
    "fixtures:external": "node scripts/external-fixtures.mjs",
    "fixtures:external:check": "node scripts/validate-external-fixture-manifest.mjs",
    "ifc:browser:check": "node scripts/validate-ifc-browser-evidence.mjs",
    "ifc:browser:evidence": "node scripts/record-ifc-browser-evidence.mjs",
    "ifc:first-frame:check": "node scripts/validate-sixty5-first-frame-evidence.mjs",
    "ifc:first-frame:evidence": "node scripts/record-ifc-browser-evidence.mjs --output artifacts/ifc/sixty5-first-frame",
    "ifc:first-frame:gecko:check": "node scripts/validate-sixty5-first-frame-gecko-evidence.mjs",
    "ifc:first-frame:gecko:evidence": "node scripts/record-ifc-browser-evidence.mjs --browser firefox --output artifacts/ifc/sixty5-first-frame-gecko",
    "ifc:edges:check": "node scripts/validate-ifc-explicit-edge-evidence.mjs",
    "ifc:engineering:check": "node scripts/validate-engineering-baseline-evidence.mjs",
    "ifc:engineering:compile": "pnpm --filter @naru3d/compiler... run build && node scripts/compile-engineering-baseline.mjs",
    "ifc:engineering:evidence": "pnpm --filter @naru3d/runtime-webgpu... run build && node scripts/record-engineering-baseline-evidence.mjs",
    "ifc:federation:check": "node scripts/validate-ifc-federation-evidence.mjs",
    "ifc:federation:evidence": "node scripts/record-ifc-federation-evidence.mjs",
    "ifc:federation:evidence:sixty5": "node scripts/record-ifc-federation-evidence.mjs output/ifc/sixty5 artifacts/ifc/sixty5 ifc-bench-sixty5",
    "lint": "pnpm run workspace:types && eslint .",
    "naru": "pnpm --filter @naru3d/compiler... run build && node packages/compiler/dist/cli.js",
    "native:check": "node scripts/check-native-tools.mjs",
    "occt:diagnostics:check": "node scripts/validate-occt-diagnostic-evidence.mjs",
    "phase1:compile:evidence": "pnpm --filter @naru3d/compiler... run build && node packages/compiler/dist/evidence-cli.js artifacts/occt/repeated-fasteners.scene.json artifacts/phase1/repeated-fasteners",
    "phase1:evidence:check": "node scripts/validate-phase1-compiled-evidence.mjs",
    "precision:check": "node scripts/validate-coordinate-precision-evidence.mjs",
    "precision:evidence": "pnpm --filter @naru3d/compiler... run build && pnpm --filter @naru3d/webgpu-spike... run build && node scripts/record-coordinate-precision-evidence.mjs",
    "safari:compatibility": "node scripts/record-safari-compatibility.mjs",
    "safari:compatibility:check": "node scripts/validate-safari-compatibility-evidence.mjs",
    "spatial:evidence": "pnpm --filter @naru3d/compiler... run build && node scripts/record-spatial-demand-evidence.mjs",
    "spatial:check": "node scripts/validate-spatial-demand-evidence.mjs",
    "spatial:localized:check": "node scripts/validate-spatial-localized-trace-evidence.mjs",
    "demand:priority:check": "node scripts/validate-demand-priority-evidence.mjs",
    "demand:priority:evidence": "node scripts/record-demand-priority-evidence.mjs",
    "memory:envelope:check": "node scripts/validate-memory-envelope-evidence.mjs",
    "memory:envelope:evidence": "node scripts/record-memory-envelope-evidence.mjs",
    "memory:envelope:gecko:evidence": "node scripts/record-memory-envelope-evidence.mjs --browser firefox",
    "spatial:localized:evidence": "node scripts/record-spatial-localized-trace-evidence.mjs",
    "spatial:package": "pnpm --filter @naru3d/compiler... run build && node scripts/compile-ifc-spatial-package.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm run workspace:types && pnpm --recursive --if-present run typecheck && pnpm exec tsc -p tsconfig.test.json",
    "workspace:types": "pnpm --filter @naru3d/scene-ir run build && pnpm --filter @naru3d/runtime-webgpu run build && pnpm --filter @naru3d/workspace run build",
    "benchmark": "pnpm --filter @naru3d/benchmark run benchmark",
    "benchmark:industrial": "node scripts/record-industrial-benchmark.mjs",
    "benchmark:industrial:check": "node scripts/validate-industrial-benchmark-evidence.mjs",
    "benchmark:heterogeneous": "node scripts/record-industrial-benchmark.mjs --output artifacts/benchmarks/heterogeneous-culling --scale target --profile heterogeneous --culling frustum --frames 90 --warmup 30",
    "benchmark:heterogeneous:check": "node scripts/validate-heterogeneous-culling-evidence.mjs",
    "benchmark:repeatability": "node scripts/record-industrial-benchmark.mjs --output artifacts/benchmarks/heterogeneous-repeatability --scale target --profile heterogeneous --culling frustum --frames 90 --warmup 30 --repeats 3 --memory scene-delta",
    "benchmark:repeatability:check": "node scripts/validate-heterogeneous-repeatability-evidence.mjs",
    "benchmark:gpu-timing": "node scripts/record-industrial-benchmark.mjs --output artifacts/benchmarks/heterogeneous-gpu-timing --scale target --profile heterogeneous --culling frustum --frames 90 --warmup 30 --repeats 3 --memory scene-delta",
    "benchmark:gpu-timing:check": "node scripts/validate-heterogeneous-gpu-timing-evidence.mjs",
    "benchmark:gpu-timing:integrated": "node scripts/record-industrial-benchmark.mjs --output artifacts/benchmarks/heterogeneous-gpu-timing-integrated --scale target --profile heterogeneous --culling frustum --frames 90 --warmup 30 --repeats 3 --memory scene-delta",
    "benchmark:gpu-timing:integrated:check": "node scripts/validate-heterogeneous-gpu-timing-evidence.mjs --directory artifacts/benchmarks/heterogeneous-gpu-timing-integrated"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "@webgpu/types": "0.1.72",
    "eslint": "10.9.0",
    "globals": "17.11.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "meshoptimizer": "1.2.0",
    "playwright": "1.60.0",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
